

{
  "manifest_version": 3,
  "name": "ANNDI BLOCK",
  "version": "1.0.1",
  "description": "Bloqueador inteligente de anúncios e rastreadores.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ANNDI BLOCK",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adblock_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
